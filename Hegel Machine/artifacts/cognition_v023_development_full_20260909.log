__ test_a_learned_sequence_executes_on_another_task_and_receives_new_feedback __

    def test_a_learned_sequence_executes_on_another_task_and_receives_new_feedback():
        library = KnowledgeLibrary()
        config = ResearchConfig(seed=503, partition="continual")
        environments = make_suite(503, "continual")
        for environment in environments[:2]:
            CognitiveAgent(config, library).run(environment)
        restored = KnowledgeLibrary.from_dict(library.to_dict())
        # A source-only suggestion need not displace the third task's own plan.
        # Continue the actual sequence until a compatible action earns transfer
        # feedback, retaining all preceding tasks as the method's learning history.
