+
+def _eval_pi_s_fine_scalar(u_drive: float, horizon_t: float, params: dict[str, float] | None = None) -> dict[str, Any]:
+    p = dict(params or DEFAULT_PI_S_ODE_PARAMS)
+    return integrate_fast_slow_ode_rk4(u_drive, horizon_t, **p)
