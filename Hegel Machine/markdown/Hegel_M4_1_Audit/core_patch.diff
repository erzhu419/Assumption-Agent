+            tr_ev = evaluate_isolated_python_model(ws_dir, "recalled_0.py", pilot_rows, isolated_prefix_rows=pilot_rows)
+            eval_count += 1
+            if tr_ev["returncode"] == 0 and float(tr_ev["rmse"]) <= lab.tolerance:
