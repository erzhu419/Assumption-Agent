+        (
+            "ode_meso_schur_reduced",
+            "meso",
+            "op_meso_schur_slaved_relax_2d",
+            ["sig:meso_internal_schur_manifold"],  # Zero direct overlap with `sig:cue_fast_probe_instrument`!
+        ),
+        (
+            "ode_distractor_planar",
+            "meso",
