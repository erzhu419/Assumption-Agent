+    # 3. Recall != Authorization on T05 (precondition guard), T13 (2-hop rollover bound), and T14 (ScaleMap block)
+    target_map = {tname: (fac, ev_fn) for _cat, tname, (fac, ev_fn) in suite["targets"]}
