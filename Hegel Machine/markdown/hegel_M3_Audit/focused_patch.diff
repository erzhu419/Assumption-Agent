+    assert res_orig["strict_pass"] is True
+    assert res_rev["strict_pass"] is True
+    assert lab_orig.meter.meas_spent == lab_rev.meter.meas_spent
+    assert lab_orig.meter.compute_spent == lab_rev.meter.compute_spent
