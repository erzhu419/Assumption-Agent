+def test_v16_9_confirmation_prefix_isolation_honest_unknown_and_bound_receipts(tmp_path: Path) -> None:
+    """Verifies F5, F7, F11: memorizer blocked (RMSE=9), sin(u) returns scoped_unknown, stale/NaN receipts denied."""
