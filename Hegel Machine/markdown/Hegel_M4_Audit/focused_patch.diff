+        mf, cf = _mk_breakdown(k_slow, k_fast, tau_f, sign, off)
+        tid = f"C{cluster_idx}_T{len(targets)+1:02d}_ClosureBreakdown"
+        lab = MultiScaleWorkspaceTaskLab(
