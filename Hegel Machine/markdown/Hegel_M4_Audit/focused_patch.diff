+        def ev(ws: Path, sub: dict[str, Any], paid: list[Observation]) -> dict[str, Any]:
+            return _evaluate_workspace_submission(
+                ws, sub.get("model_path"), paid, heldout, rmse_tol, submission_status=str(sub.get("status", "incomplete"))
