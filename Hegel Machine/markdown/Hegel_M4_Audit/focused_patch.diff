+            return OpenWorkspaceTaskLab(
+                task_id=tid,
+                surface_domain=domain,
+                feature_names=fnames,
+                feature_bounds=fbounds,
+                cost_per_obs=5.0,
+                task_view=tv,
+                meter=meter,
+                private_oracle_fn=lambda pt: out_y(clean_fn(pt)),
+                private_readout_cal_fn=cal,
+                noise_std=0.002,
+                noise_seed=nseed,
