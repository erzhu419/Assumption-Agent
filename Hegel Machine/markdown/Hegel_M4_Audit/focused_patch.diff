+
+        def fac() -> OpenWorkspaceTaskLab:
+            meter = CostMeter(obs_budget=28, meas_budget=140.0, compute_budget=1600.0)
+            cal = (lambda lv: out_y(lv)) if expose_cal else None
+            tv: dict[str, Any] = {
