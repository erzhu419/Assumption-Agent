+        targets.append(MultiScaleTargetSpec(
+            target_id=tid,
+            category="T_Closure_Breakdown",
+            lab=lab,
+            pilot_points=[
+                {"drive_u": 0.6, "quench_t": 0.08},
+                {"drive_u": 1.4, "quench_t": 0.20},
