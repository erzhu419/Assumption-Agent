+
+        wrapped_sources.append((s_name, (_make_wrapped_src(), s_ev)))
+        # Add +1 direct-assay partner for S24 (`monod_plus_linear_2d`) so S24(-1) <-> S24P(+1) -> NM04(haldane) forms a pure 2-hop walk!
