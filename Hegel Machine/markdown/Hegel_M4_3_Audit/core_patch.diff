+@dataclass(frozen=True)
+class M43TargetSpec:
+    """Unified single- or two-channel unseen target specification for ``V17.5 (M4.3)``."""
+
+    target_id: str
+    mechanism_family: str
+    feature_names: tuple[str, ...]
