+
+    # Seed-varied Out-of-Scope Honesty Targets (`2` per seed -> `8` distinct OOS across 4 seeds)
+    oos_targets: list[M43TargetSpec] = []
+    for o_i in range(2):
+        freq = round(rng.uniform(5.9, 7.7), 3)
