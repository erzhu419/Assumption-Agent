{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "properties": {
        "arm": {
          "type": "string"
        },
        "type": {
          "enum": [
            "apply_candidate",
            "collect_evidence",
            "repair_scope",
            "run_ablation",
            "select_profile"
          ]
        }
      },
      "required": [
        "type",
        "arm"
      ],
      "type": "object"
    },
    "outcome": {
      "required": [
        "accepted",
        "utility_vs_baseline",
        "control_harm",
        "regression",
        "cost"
      ],
      "type": "object"
    },
    "prediction": {
      "required": [
        "p_accept",
        "p_regress",
        "expected_utility",
        "uncertainty"
      ],
      "type": "object"
    },
    "provenance": {
      "required": [
        "artifact_id",
        "source_row_id",
        "split",
        "redacted",
        "provenance_hash"
      ],
      "type": "object"
    },
    "row_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "simulator_transition_schema_v0"
    },
    "state": {
      "required": [
        "domain",
        "pattern",
        "active_assumptions",
        "residual_cluster",
        "formal_gate_state",
        "preflight_state",
        "world_model_features"
      ],
      "type": "object"
    }
  },
  "required": [
    "row_id",
    "schema_version",
    "state",
    "action",
    "prediction",
    "outcome",
    "provenance"
  ],
  "title": "simulator_transition_schema_v0",
  "type": "object"
}
