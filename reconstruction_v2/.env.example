ASSUMPTION_V2_API_BASE=https://example.invalid
ASSUMPTION_V2_API_KEY=replace-me
ASSUMPTION_V2_MODEL=gpt-5.3-codex-spark
ASSUMPTION_V2_ALLOW_ALTERNATE_MODEL=0
ASSUMPTION_V2_PROVIDER_CHAIN=codex_app_server,openai_compatible
# Optional; defaults to codex on PATH.
# ASSUMPTION_V2_CODEX_PATH=/absolute/path/to/codex
ASSUMPTION_V2_CODEX_REASONING_EFFORT=low
ASSUMPTION_V2_CODEX_REQUEST_IDLE_SECONDS=60
ASSUMPTION_V2_CODEX_TURN_IDLE_SECONDS=300
ASSUMPTION_V2_CODEX_ATTEMPTS=1
ASSUMPTION_V2_SKILLLEARN_PROVIDER_MODE=codex_subscription
# Optional overrides; values are never persisted in reports.
# ASSUMPTION_V2_CODEX_AUTH_PATH=/absolute/path/to/.codex/auth.json
# ASSUMPTION_V2_SECRET_TMPDIR=/tmp
