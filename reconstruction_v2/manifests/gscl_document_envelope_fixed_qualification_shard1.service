[Unit]
Description=GSCL fixed public document-envelope qualification shard 1/2
After=default.target
ConditionPathIsDirectory=@QWEN_MODEL_ROOT@
ConditionPathExists=@QWEN_MODEL_MANIFEST@
ConditionPathExists=@UPSTREAM_LEAF_AGGREGATE_RECEIPT@
ConditionPathIsDirectory=@QUALIFICATION_ROOT@/shard1/tmp

[Service]
Type=oneshot
WorkingDirectory=@RECONSTRUCTION_ROOT@
ExecStart=@RUNTIME_PYTHON@ -m replication_runtime.gscl_narrative_extractor_v2.fixed_document_envelope_qualification shard --model-root @QWEN_MODEL_ROOT@ --model-manifest @QWEN_MODEL_MANIFEST@ --upstream-aggregate-receipt @UPSTREAM_LEAF_AGGREGATE_RECEIPT@ --output-root @QUALIFICATION_ROOT@/shard1 --shard-index 1 --shard-count 2
Environment=CUDA_VISIBLE_DEVICES=@GPU1_UUID@
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=@RECONSTRUCTION_ROOT@
Environment=TMPDIR=@QUALIFICATION_ROOT@/shard1/tmp
Environment=HOME=@QUALIFICATION_ROOT@/shard1/home
Environment=XDG_CACHE_HOME=@QUALIFICATION_ROOT@/shard1/cache
Environment=HF_HOME=@QUALIFICATION_ROOT@/shard1/hf
Environment=TORCH_HOME=@QUALIFICATION_ROOT@/shard1/torch
UnsetEnvironment=OPENAI_API_KEY OPENAI_BASE_URL ANTHROPIC_API_KEY RUOLI_API_KEY HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
CPUQuota=150%
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
TasksMax=64
Nice=10
NoNewPrivileges=yes
ProtectSystem=no
ProtectHome=no
PrivateTmp=no
ReadWritePaths=
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
Restart=no
TimeoutStartSec=infinity
UMask=0077
