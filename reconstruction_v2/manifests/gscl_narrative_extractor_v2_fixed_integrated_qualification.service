[Unit]
Description=GSCL v2 fixed public source-free four-arm integrated qualification
After=default.target
ConditionPathIsDirectory=@QWEN_MODEL_ROOT@
ConditionPathExists=@QWEN_MODEL_MANIFEST@
ConditionPathExists=@UPSTREAM_AGGREGATE_RECEIPT@
ConditionPathIsDirectory=@QUALIFICATION_ROOT@/tmp

[Service]
Type=oneshot
WorkingDirectory=@RECONSTRUCTION_ROOT@
ExecStart=@RUNTIME_PYTHON@ -m replication_runtime.gscl_narrative_extractor_v2.fixed_public_integrated_qualification --model-root @QWEN_MODEL_ROOT@ --model-manifest @QWEN_MODEL_MANIFEST@ --upstream-aggregate-receipt @UPSTREAM_AGGREGATE_RECEIPT@ --output-root @QUALIFICATION_ROOT@
Environment=CUDA_VISIBLE_DEVICES=0
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=@RECONSTRUCTION_ROOT@
Environment=TMPDIR=@QUALIFICATION_ROOT@/tmp
Environment=HOME=@QUALIFICATION_ROOT@/home
Environment=XDG_CACHE_HOME=@QUALIFICATION_ROOT@/cache
Environment=HF_HOME=@QUALIFICATION_ROOT@/hf
Environment=TORCH_HOME=@QUALIFICATION_ROOT@/torch
CPUQuota=200%
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
TasksMax=64
Nice=10
NoNewPrivileges=yes
# Exact source-free qualification on the previously qualified jtl311linux
# user-service contract.  ProtectHome/ReadWritePaths would request an
# unprivileged mount namespace on this host and make "/" non-traversable.
ProtectSystem=no
ProtectHome=no
PrivateTmp=no
ReadWritePaths=
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
Restart=no
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=default.target
