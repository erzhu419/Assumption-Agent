Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/code/reconstruction_v2
Environment=HOME=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/formal/home
Environment=TMPDIR=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/formal/tmp
Environment=TMP=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/formal/tmp
Environment=TEMP=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/formal/tmp
CPUQuota=600%
CPUWeight=25
IOWeight=25
IOSchedulingClass=idle
MemoryHigh=24G
MemoryMax=32G
MemorySwapMax=0
TasksMax=128
Nice=10
NoNewPrivileges=yes
PrivateDevices=no
PrivateTmp=no
ProtectSystem=no
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
Restart=no
SuccessExitStatus=75
RuntimeMaxSec=infinity
TimeoutStartSec=infinity
UMask=0077

[Install]
