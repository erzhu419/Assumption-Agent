[Unit]
Description=GSCL v2 fixed label-blind ARN input compatibility shard 1/2
ConditionPathIsDirectory=@QWEN_MODEL_ROOT@
ConditionPathExists=@QWEN_MODEL_MANIFEST@
ConditionPathExists=@INTEGRATED_QUALIFICATION_RECEIPT@
ConditionPathExists=@PREDICTOR_PACK@
ConditionPathIsDirectory=@COMPATIBILITY_ROOT@/shard1/tmp

[Service]
Type=oneshot
WorkingDirectory=@RECONSTRUCTION_ROOT@
ExecStart=@RUNTIME_PYTHON@ -m replication_runtime.gscl_narrative_extractor_v2.fixed_arn_input_compatibility shard --model-root @QWEN_MODEL_ROOT@ --model-manifest @QWEN_MODEL_MANIFEST@ --integrated-qualification-receipt @INTEGRATED_QUALIFICATION_RECEIPT@ --predictor-pack @PREDICTOR_PACK@ --output-root @COMPATIBILITY_ROOT@/shard1 --shard-index 1 --shard-count 2
Environment=CUDA_VISIBLE_DEVICES=1
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=@RECONSTRUCTION_ROOT@
Environment=TMPDIR=@COMPATIBILITY_ROOT@/shard1/tmp
Environment=HOME=@COMPATIBILITY_ROOT@/shard1/home
Environment=XDG_CACHE_HOME=@COMPATIBILITY_ROOT@/shard1/cache
Environment=HF_HOME=@COMPATIBILITY_ROOT@/shard1/hf
Environment=TORCH_HOME=@COMPATIBILITY_ROOT@/shard1/torch
CPUQuota=200%
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=12G
MemoryMax=16G
MemorySwapMax=0
TasksMax=64
Nice=10
NoNewPrivileges=yes
ProtectSystem=no
ProtectHome=no
PrivateTmp=no
ReadWritePaths=
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
Restart=no
TimeoutStartSec=infinity
UMask=0077
