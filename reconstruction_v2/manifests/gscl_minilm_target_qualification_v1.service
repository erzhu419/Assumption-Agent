[Unit]
Description=GSCL source-free MiniLM target qualification
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/var/tmp/gscl_unified_nonscoring_harness_20260730/qualification_code/minilm_target_v1/reconstruction_v2
ExecStart=/home/erzhu419/p19_runtime_assets_20260723/typed_venv/bin/python -m replication_runtime.gscl_minilm_portable_v1.target_qualification --asset-manifest /var/tmp/gscl_unified_nonscoring_harness_20260730/assets/minilm_asset_manifest.json --model /var/tmp/gscl_unified_nonscoring_harness_20260730/assets/minilm_model --output-bundle /var/tmp/gscl_unified_nonscoring_harness_20260730/assets/minilm_target_qualification_v1
Environment=PYTHONPATH=/var/tmp/gscl_unified_nonscoring_harness_20260730/qualification_code/minilm_target_v1/reconstruction_v2
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
Environment=CUDA_MODULE_LOADING=LAZY
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=
Environment=HF_DATASETS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=HF_HUB_OFFLINE=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONHASHSEED=0
Environment=PYTHONNOUSERSITE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=TRANSFORMERS_OFFLINE=1
Environment=VECLIB_MAXIMUM_THREADS=1
Environment=TMPDIR=/var/tmp
Environment=TMP=/var/tmp
Environment=TEMP=/var/tmp
CPUQuota=200%
CPUWeight=25
IOWeight=25
IOSchedulingClass=idle
MemoryHigh=8G
MemoryMax=12G
MemorySwapMax=0
TasksMax=64
Nice=10
NoNewPrivileges=yes
PrivateDevices=no
PrivateTmp=no
ProtectSystem=no
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
Restart=no
RuntimeMaxSec=infinity
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=default.target
