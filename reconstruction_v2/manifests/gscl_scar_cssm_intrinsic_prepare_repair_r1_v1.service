[Unit]
Description=GSCL SCAR CSSM intrinsic formal private source preparation
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/code/reconstruction_v2
ExecStart=/var/tmp/gscl_unified_nonscoring_harness_20260730/assets/gscl_runtime_ext4_v1/typed_venv/bin/python -m replication_runtime.gscl_scar_cssm_v1.prepare --source /var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/private_source/system_analogy_en.json --output-root /var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/private_input --study-id GSCL_SCAR_CSSM_INTRINSIC_FORMAL_V1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/code/reconstruction_v2
Environment=HOME=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/prepare/home
Environment=TMPDIR=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/prepare/tmp
Environment=TMP=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/prepare/tmp
Environment=TEMP=/var/tmp/gscl_scar_cssm_intrinsic_formal_20260801/v1/service_tmp/prepare/tmp
CPUQuota=100%
CPUWeight=25
IOWeight=25
IOSchedulingClass=idle
MemoryHigh=2G
MemoryMax=4G
MemorySwapMax=0
TasksMax=32
Nice=10
NoNewPrivileges=yes
PrivateDevices=no
PrivateTmp=no
ProtectSystem=no
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
Restart=no
RuntimeMaxSec=30m
TimeoutStartSec=30m
UMask=0077

[Install]
WantedBy=default.target
